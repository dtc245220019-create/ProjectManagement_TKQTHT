<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container py-4">
  <!-- Project Summary Card -->
  <div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-4">
      <div class="d-flex flex-wrap justify-content-between align-items-start mb-3">
        <div>
          <div class="d-flex align-items-center mb-1">
            <span class="badge bg-secondary font-monospace fs-6 me-2"><%= project.code %></span>
            <h3 class="fw-bold mb-0 text-dark"><%= project.name %></h3>
          </div>
          <p class="text-muted mb-0"><%= project.description || 'Chưa có mô tả chi tiết.' %></p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
          <a href="/projects/<%= project.id %>/edit" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-pencil me-1"></i> Chỉnh sửa
          </a>
          <% if (currentUser && currentUser.role === 'admin') { %>
            <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteProjectModal">
              <i class="bi bi-trash me-1"></i> Xóa
            </button>
          <% } %>
        </div>
      </div>

      <hr>

      <div class="row g-3 text-sm">
        <div class="col-sm-6 col-md-3">
          <span class="text-muted d-block small">Trạng thái:</span>
          <% if (project.status === 'In Progress') { %>
            <span class="badge bg-primary">Đang triển khai</span>
          <% } else if (project.status === 'Completed') { %>
            <span class="badge bg-success">Hoàn thành</span>
          <% } else if (project.status === 'Planning') { %>
            <span class="badge bg-secondary">Lập kế hoạch</span>
          <% } else { %>
            <span class="badge bg-warning text-dark"><%= project.status %></span>
          <% } %>
        </div>
        <div class="col-sm-6 col-md-3">
          <span class="text-muted d-block small">Độ ưu tiên:</span>
          <span class="badge <%= project.priority === 'Critical' ? 'bg-danger' : (project.priority === 'High' ? 'bg-warning text-dark' : 'bg-info text-dark') %>">
            <%= project.priority %>
          </span>
        </div>
        <div class="col-sm-6 col-md-3">
          <span class="text-muted d-block small">Quản lý Dự án:</span>
          <strong><%= project.manager_name || 'Chưa phân công' %></strong>
        </div>
        <div class="col-sm-6 col-md-3">
          <span class="text-muted d-block small">Ngân sách:</span>
          <strong><%= Number(project.budget).toLocaleString('vi-VN') %> đ</strong>
        </div>
      </div>

      <div class="mt-3">
        <% 
          const totalT = parseInt(project.total_tasks, 10) || 0;
          const doneT = parseInt(project.completed_tasks, 10) || 0;
          const percent = totalT > 0 ? Math.round((doneT / totalT) * 100) : 0;
        %>
        <div class="d-flex justify-content-between align-items-center mb-1 small">
          <span class="fw-semibold">Tiến độ hoàn thành công việc:</span>
          <span><strong><%= doneT %>/<%= totalT %></strong> tasks (<%= percent %>%)</span>
        </div>
        <div class="progress" style="height: 10px;">
          <div class="progress-bar bg-success" role="progressbar" style="width: <%= percent %>%;"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- Cột Tasks -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-check2-square text-primary me-2"></i>Danh sách Công việc (<%= tasks.length %>)</h5>
          <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addTaskModal">
            <i class="bi bi-plus-lg me-1"></i> Thêm Task
          </button>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Tiêu đề</th>
                  <th>Người làm</th>
                  <th>Hạn chót</th>
                  <th>Trạng thái</th>
                  <th class="text-end">Thao tác</th>
                </tr>
              </thead>
              <tbody>
                <% if (tasks.length === 0) { %>
                  <tr><td colspan="5" class="text-center py-4 text-muted">Chưa có công việc nào trong dự án này.</td></tr>
                <% } else { %>
                  <% tasks.forEach(t => { %>
                    <tr>
                      <td>
                        <div class="fw-semibold text-dark"><%= t.title %></div>
                        <small class="text-muted text-truncate d-inline-block" style="max-width: 250px;"><%= t.description || 'Không có ghi chú' %></small>
                      </td>
                      <td><%= t.assignee_name || 'Chưa gán' %></td>
                      <td><%= t.due_date ? new Date(t.due_date).toLocaleDateString('vi-VN') : '-' %></td>
                      <td>
                        <form action="/tasks/<%= t.id %>/status" method="POST" class="d-inline">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="redirect" value="/projects/<%= project.id %>">
                          <select name="status" class="form-select form-select-sm" onchange="this.form.submit()" style="width: auto;">
                            <option value="Todo" <%= t.status === 'Todo' ? 'selected' : '' %>>Todo</option>
                            <option value="In Progress" <%= t.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                            <option value="Review" <%= t.status === 'Review' ? 'selected' : '' %>>Review</option>
                            <option value="Done" <%= t.status === 'Done' ? 'selected' : '' %>>Done</option>
                          </select>
                        </form>
                      </td>
                      <td class="text-end">
                        <form action="/tasks/<%= t.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa task này?');">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="redirect" value="/projects/<%= project.id %>">
                          <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Xóa task"><i class="bi bi-trash"></i></button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Cột Thành viên tham gia dự án -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-people text-info me-2"></i>Thành viên (<%= assignedMembers.length %>)</h5>
          <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#assignMemberModal">
            <i class="bi bi-person-plus me-1"></i> Gán
          </button>
        </div>
        <div class="card-body p-0">
          <ul class="list-group list-group-flush">
            <% if (assignedMembers.length === 0) { %>
              <li class="list-group-item text-center py-3 text-muted">Chưa gán thành viên nào.</li>
            <% } else { %>
              <% assignedMembers.forEach(m => { %>
                <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                  <div>
                    <div class="fw-semibold"><%= m.full_name %></div>
                    <small class="text-muted"><%= m.project_role %> • <%= m.department %></small>
                  </div>
                  <form action="/projects/<%= project.id %>/members/<%= m.id %>/remove" method="POST" onsubmit="return confirm('Xóa thành viên khỏi dự án?');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-sm btn-outline-danger border-0 p-1" title="Bỏ gán"><i class="bi bi-x-circle"></i></button>
                  </form>
                </li>
              <% }) %>
            <% } %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal Thêm Task -->
<div class="modal fade" id="addTaskModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/tasks" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="project_id" value="<%= project.id %>">
        <div class="modal-header">
          <h5 class="modal-title fw-bold">Thêm Công việc Mới</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-semibold">Tiêu đề công việc <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="title" required placeholder="Nhập tên việc cần làm...">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Mô tả</label>
            <textarea class="form-control" name="description" rows="2" placeholder="Chi tiết yêu cầu..."></textarea>
          </div>
          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label fw-semibold">Độ ưu tiên</label>
              <select class="form-select" name="priority">
                <option value="Medium">Medium</option>
                <option value="High">High</option>
                <option value="Critical">Critical</option>
                <option value="Low">Low</option>
              </select>
            </div>
            <div class="col-6">
              <label class="form-label fw-semibold">Trạng thái</label>
              <select class="form-select" name="status">
                <option value="Todo">Todo</option>
                <option value="In Progress">In Progress</option>
                <option value="Review">Review</option>
                <option value="Done">Done</option>
              </select>
            </div>
          </div>
          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label fw-semibold">Người thực hiện</label>
              <select class="form-select" name="assigned_to">
                <option value="">-- Chưa gán --</option>
                <% allMembers.forEach(m => { %>
                  <option value="<%= m.id %>"><%= m.full_name %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-6">
              <label class="form-label fw-semibold">Hạn chót</label>
              <input type="date" class="form-control" name="due_date">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Thời gian ước tính (Giờ)</label>
            <input type="number" step="0.5" class="form-control" name="estimated_hours" value="8">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
          <button type="submit" class="btn btn-primary">Thêm Task</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal Gán Thành viên -->
<div class="modal fade" id="assignMemberModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/projects/<%= project.id %>/members" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-header">
          <h5 class="modal-title fw-bold">Gán Thành viên vào Dự án</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-semibold">Chọn thành viên</label>
            <select class="form-select" name="member_id" required>
              <% allMembers.forEach(m => { %>
                <option value="<%= m.id %>"><%= m.full_name %> (<%= m.role %> - <%= m.department %>)</option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Vai trò trong dự án này</label>
            <input type="text" class="form-control" name="project_role" value="Developer" required placeholder="VD: Leader, Frontend Dev, Tester...">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-primary">Xác nhận Gán</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal Xóa Dự án -->
<% if (currentUser && currentUser.role === 'admin') { %>
  <div class="modal fade" id="deleteProjectModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <form action="/projects/<%= project.id %>/delete" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="modal-header bg-danger text-white">
            <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa Dự án</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <p>Hành động này sẽ xóa hoàn toàn dự án <strong><%= project.name %></strong> (<%= project.code %>) cùng toàn bộ tasks và phân công thành viên liên quan.</p>
            <p class="text-danger mb-0 fw-semibold">Thao tác này không thể hoàn tác!</p>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
            <button type="submit" class="btn btn-danger">Xóa Vĩnh Viễn</button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
